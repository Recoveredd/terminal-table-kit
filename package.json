{
  "name": "terminal-table-kit",
  "version": "0.1.1",
  "description": "Parse fixed-width terminal table output into typed rows.",
  "type": "module",
  "sideEffects": false,
  "license": "MPL-2.0",
  "author": "Recoveredd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recoveredd/terminal-table-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Recoveredd/terminal-table-kit/issues"
  },
  "homepage": "https://github.com/Recoveredd/terminal-table-kit#readme",
  "keywords": [
    "terminal",
    "table",
    "parser",
    "cli",
    "fixed-width",
    "stdout",
    "shell",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
